function MenuView({ menuItems, navigateToDetails }) {
  const [searchTerm, setSearchTerm] = useState('');
  const [selectedCategory, setSelectedCategory] = useState('All');
  const [favoritesOnly, setFavoritesOnly] = useState(false);
  const [dietaryFilter, setDietaryFilter] = useState('All');

  const { favorites } = useFavorites();

  const categories = ['All', 'Breakfast', 'Main Meals', 'Snacks & Street Food', 'Beverages', 'Desserts'];

  // Filter Logic
  const filteredItems = useMemo(() => {
    return menuItems.filter((item) => {
      // Category check
      const matchesCategory = selectedCategory === 'All' || item.category === selectedCategory;
      
      // Search term check
      const matchesSearch =
        item.name.toLowerCase().includes(searchTerm.toLowerCase()) ||
        item.description.toLowerCase().includes(searchTerm.toLowerCase());

      // Favorites filter
      const matchesFavorites = !favoritesOnly || favorites.includes(item.id);

      // Dietary filter
      const matchesDietary = dietaryFilter === 'All' || item.dietary === dietaryFilter;

      return matchesCategory && matchesSearch && matchesFavorites && matchesDietary;
    });
  }, [menuItems, selectedCategory, searchTerm, favoritesOnly, dietaryFilter, favorites]);

  return (
    <div className="space-y-5 animate-fade-in">
      {/* Search Bar & Primary Controls */}
      <div className="bg-white p-3.5 sm:p-4 rounded-2xl shadow-sm border border-slate-200 space-y-3">
        <div className="relative">
          <Search className="absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 w-4 h-4" />
          <input
            type="text"
            placeholder="Search menu items, ingredients..."
            value={searchTerm}
            onChange={(e) => setSearchTerm(e.target.value)}
            className="w-full pl-10 pr-9 py-2.5 bg-slate-50 hover:bg-slate-100/80 focus:bg-white text-sm rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-amber-500/50 focus:border-amber-500 transition-all"
          />
          {searchTerm && (
            <button
              onClick={() => setSearchTerm('')}
              className="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 p-0.5"
            >
              <X className="w-4 h-4" />
            </button>
          )}
        </div>

        {/* Toggle Pills (Favorites & Dietary Types) */}
        <div className="flex flex-wrap items-center justify-between gap-2 pt-1 border-t border-slate-100 text-xs">
          <div className="flex items-center gap-1.5">
            <button
              onClick={() => setFavoritesOnly(!favoritesOnly)}
              className={`flex items-center gap-1.5 px-3 py-1.5 rounded-lg border font-semibold transition-all ${
                favoritesOnly
                  ? 'bg-rose-50 border-rose-200 text-rose-600 shadow-sm'
                  : 'bg-slate-50 border-slate-200 text-slate-600 hover:bg-slate-100'
              }`}
            >
              <Heart className={`w-3.5 h-3.5 ${favoritesOnly ? 'fill-rose-500 text-rose-500' : ''}`} />
              <span>Favorites Only</span>
              {favorites.length > 0 && (
                <span className="ml-1 px-1.5 py-0.2 bg-rose-200/60 text-rose-700 rounded-full text-[10px]">
                  {favorites.length}
                </span>
              )}
            </button>
          </div>

          <div className="flex items-center gap-1.5 overflow-x-auto no-scrollbar py-0.5">
            <span className="text-slate-400 text-[11px] font-medium hidden sm:inline">Dietary:</span>
            {['All', 'Veg', 'Non-Veg', 'Vegan'].map((diet) => (
              <button
                key={diet}
                onClick={() => setDietaryFilter(diet)}
                className={`px-2.5 py-1 rounded-lg text-xs font-medium transition-colors ${
                  dietaryFilter === diet
                    ? 'bg-slate-800 text-white shadow-sm'
                    : 'bg-slate-100 text-slate-600 hover:bg-slate-200'
                }`}
              >
                {diet}
              </button>
            ))}
          </div>
        </div>
      </div>

      {/* Category Horizontal Scroll Pills */}
      <div className="flex items-center gap-2 overflow-x-auto pb-1 no-scrollbar scroll-smooth">
