// ==========================================
// CONTEXT PROVIDERS (Cart & Favorites)
// ==========================================
const CartContext = createContext();
const FavoritesContext = createContext();

export const CartProvider = ({ children }) => {
  const [cart, setCart] = useState([]);

  const addToCart = (item, quantity = 1, options = {}) => {
    setCart((prev) => {
      // Find if exact item with same options exists
      const existingIndex = prev.findIndex(
        (ci) =>
          ci.id === item.id &&
          ci.spiceChoice === options.spiceChoice &&
          JSON.stringify(ci.selectedAddOns?.sort()) === JSON.stringify(options.selectedAddOns?.sort())
      );

      if (existingIndex > -1) {
        const updated = [...prev];
        updated[existingIndex].quantity += quantity;
        return updated;
      } else {
        const itemTotalPrice = item.price + (options.extraCost || 0);
        return [
          ...prev,
          {
            ...item,
            cartItemId: `${item.id}-${Date.now()}`,
            quantity,
            unitPrice: itemTotalPrice,
            spiceChoice: options.spiceChoice || 'Default',
            selectedAddOns: options.selectedAddOns || [],
            notes: options.notes || ''
          }
        ];
      }
    });
  };

  const removeFromCart = (cartItemId) => {
    setCart((prev) => prev.filter((item) => item.cartItemId !== cartItemId));
  };

  const updateQuantity = (cartItemId, delta) => {
    setCart((prev) =>
      prev
        .map((item) => {
          if (item.cartItemId === cartItemId) {
            const newQty = item.quantity + delta;
            return newQty > 0 ? { ...item, quantity: newQty } : null;
          }
          return item;
        })
        .filter(Boolean)
    );
  };

  const clearCart = () => setCart([]);

  const totalItemsCount = useMemo(() => cart.reduce((sum, item) => sum + item.quantity, 0), [cart]);
  const subtotal = useMemo(() => cart.reduce((sum, item) => sum + item.unitPrice * item.quantity, 0), [cart]);

  return (
    <CartContext.Provider
      value={{
        cart,
        addToCart,
        removeFromCart,
        updateQuantity,
        clearCart,
        totalItemsCount,
        subtotal
      }}
    >
      {children}
    </CartContext.Provider>
  );
};

export const FavoritesProvider = ({ children }) => {
  const [favorites, setFavorites] = useState(['m1', 'm4']);

  const toggleFavorite = (id) => {
    setFavorites((prev) => (prev.includes(id) ? prev.filter((fav) => fav !== id) : [...prev, id]));
  };

  return (
    <FavoritesContext.Provider value={{ favorites, toggleFavorite }}>
      {children}
    </FavoritesContext.Provider>
  );
};

const useCart = () => useContext(CartContext);
const useFavorites = () => useContextFavorites();
const useContextFavorites = () => useContext(FavoritesContext);

